# ============================================================
#  QuantEdge — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Paper mode works without API keys (uses public market data).

# ── Binance API (Required for Live Mode) ─────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Telegram Notifications (Optional) ────────────────────────
# Get your bot token from @BotFather
# Get your chat ID from @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── LLM Provider (Optional — for market narratives) ──────────
# Supports: OpenAI, Gemini, Groq, OpenRouter
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
